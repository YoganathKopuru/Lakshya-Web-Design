{
  "name": "lakshya-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/preview.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests playwright.config.ts .github package.json README.md CONTRIBUTING.md",
    "format:check": "prettier --check src scripts tests playwright.config.ts .github package.json README.md CONTRIBUTING.md"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22.1"
  }
}
